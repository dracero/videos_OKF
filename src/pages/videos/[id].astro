---
import Layout from '../../layouts/Layout.astro';
import { getVideoById, getChannelById, getLastSync } from '../../lib/okf-reader';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const video = await getVideoById(id);
if (!video) {
  return new Response('Video no encontrado', { status: 404 });
}

const channel = await getChannelById(video.channel_id);
const lastSyncObj = await getLastSync();
const lastSync = lastSyncObj?.timestamp || null;

const tagsList = Array.isArray(video.tags) ? video.tags : [];

// Extract start time parameter 't' (in seconds) and rewrite iframe src inside bodyHtml
const t = Astro.url.searchParams.get('t');
let bodyHtml = video.bodyHtml;
if (t) {
  const startSeconds = parseInt(t, 10);
  if (!isNaN(startSeconds)) {
    bodyHtml = bodyHtml.replace(
      /src="https:\/\/www\.youtube\.com\/embed\/([^"?]+)"/g,
      `src="https://www.youtube.com/embed/$1?start=${startSeconds}&autoplay=1"`
    );
  }
}
---

<Layout title={video.title} lastSync={lastSync}>
  <!-- Back links -->
  <div class="navigation-wrapper">
    <a href="/" class="back-link">← Catálogo</a>
    <span class="nav-separator">/</span>
    {channel && (
      <a href={`/channels/${channel.id}`} class="back-link">{channel.title}</a>
      <span class="nav-separator">/</span>
    )}
    <span class="nav-current">Detalle del Video</span>
  </div>

  <div class="video-layout">
    <!-- Main Content Column -->
    <div class="main-column">
      <!-- Video Details & Body (rendered directly from the OKF Markdown document) -->
      <div class="video-body-card">
        <article class="markdown-content" set:html={bodyHtml}></article>
      </div>
      
      <!-- Video Tags -->
      {tagsList.length > 0 && (
        <div class="tags-card">
          <h4 class="tags-title">Etiquetas</h4>
          <div class="tags-list">
            {tagsList.map(tag => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- OKF Sidebar Column -->
    <aside class="sidebar-column">
      <div class="okf-metadata-card">
        <div class="okf-card-header">
          <span class="okf-icon">ℹ</span>
          <h3>Concepto OKF</h3>
        </div>
        
        <div class="metadata-list">
          <div class="metadata-item">
            <span class="meta-label">Concept ID</span>
            <span class="meta-value monospace" title={`videos/${video.id}`}>{video.id.substring(0, 15)}...</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Type</span>
            <span class="meta-value okf-type">{video.type}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Status</span>
            <span class="meta-value status-active">{video.status}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Verified</span>
            <span class="meta-value verified-badge">{video.verified}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Resource</span>
            <a href={video.resource} target="_blank" rel="noopener noreferrer" class="meta-value link-value">
              Ver en YouTube ↗
            </a>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Duration</span>
            <span class="meta-value monospace">{video.duration}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Views</span>
            <span class="meta-value monospace">{(video.view_count || 0).toLocaleString('es-ES')}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Likes</span>
            <span class="meta-value monospace">{(video.like_count || 0).toLocaleString('es-ES')}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Comments</span>
            <span class="meta-value monospace">{(video.comment_count || 0).toLocaleString('es-ES')}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Published At</span>
            <span class="meta-value monospace">{new Date(video.published_at).toLocaleDateString('es-ES')}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Generated</span>
            <span class="meta-value monospace">{new Date(video.generated?.at).toLocaleDateString('es-ES')}</span>
          </div>
        </div>

        <div class="provenance-section">
          <h4>Procedencia (Sources)</h4>
          {video.sources?.map((source: any) => (
            <div class="source-item">
              <span class="source-title">{source.title}</span>
              <span class="source-resource" title={source.resource}>{source.resource.split('/').pop()}</span>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .navigation-wrapper {
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-purple);
  }

  .nav-separator {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .nav-current {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Grid Layout layout */
  .video-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0; /* Prevents flex children from breaking parent layout */
  }

  /* Video card body details */
  .video-body-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: 16px;
    backdrop-filter: blur(8px);
  }

  /* Markdown Content Styling */
  .markdown-content :global(h1) {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .markdown-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-left: 3px solid var(--accent-purple);
    padding-left: 0.75rem;
  }

  .markdown-content :global(p) {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    white-space: pre-wrap; /* Preserve YouTube description formatting spacing */
  }

  .markdown-content :global(ul) {
    list-style-type: none;
    margin-bottom: 1.5rem;
    padding-left: 0.5rem;
  }

  .markdown-content :global(li) {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .markdown-content :global(li::before) {
    content: "•";
    color: var(--accent-purple);
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .markdown-content :global(a) {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .markdown-content :global(a:hover) {
    color: var(--text-primary);
    text-decoration: underline;
  }

  /* Responsive iframe styling inside parsed html */
  .markdown-content :global(.video-embed-container) {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 ratio */
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .markdown-content :global(.video-embed-container iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Tags Card style */
  .tags-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.5rem 2rem;
    border-radius: 16px;
  }

  .tags-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tags-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Sidebar styling */
  .okf-metadata-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
    position: sticky;
    top: 5.5rem;
  }

  .okf-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .okf-icon {
    font-size: 1.1rem;
    color: var(--accent-purple);
  }

  .okf-card-header h3 {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .metadata-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-value {
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .meta-value.monospace {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .okf-type {
    background-color: var(--accent-blue-glow);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--accent-blue);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    display: inline-block;
    width: fit-content;
    font-weight: 600;
    font-size: 0.75rem;
  }

  .status-active {
    color: var(--accent-green);
    font-weight: 600;
    text-transform: capitalize;
  }

  .verified-badge {
    background-color: var(--accent-green-glow);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: var(--accent-green);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    display: inline-block;
    width: fit-content;
    font-weight: 600;
    font-size: 0.75rem;
  }

  .link-value {
    color: var(--accent-purple);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .link-value:hover {
    color: var(--text-primary);
  }

  /* Provenance Section */
  .provenance-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .provenance-section h4 {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .source-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 0.5rem;
  }

  .source-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .source-resource {
    font-size: 0.75rem;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    word-break: break-all;
  }

  @media (max-width: 900px) {
    .video-layout {
      grid-template-columns: 1fr;
    }
    .sidebar-column {
      position: static;
    }
    .okf-metadata-card {
      position: static;
    }
  }
</style>
