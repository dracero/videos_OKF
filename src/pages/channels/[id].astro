---
import Layout from '../../layouts/Layout.astro';
import { getChannelById, getVideos, getLastSync } from '../../lib/okf-reader';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const channel = await getChannelById(id);
if (!channel) {
  return new Response('Canal no encontrado', { status: 404 });
}

const allVideos = await getVideos();
const channelVideos = allVideos.filter(v => v.channel_id === id);
const lastSyncObj = await getLastSync();
const lastSync = lastSyncObj?.timestamp || null;
---

<Layout title={channel.title} lastSync={lastSync}>
  <!-- Back link -->
  <div class="navigation-wrapper">
    <a href="/" class="back-link">← Volver al catálogo</a>
  </div>

  <div class="channel-layout">
    <!-- Main Info Column -->
    <div class="main-column">
      <!-- Channel Info Card -->
      <div class="channel-header-card">
        <img src={channel.thumbnail} alt={channel.title} class="channel-large-avatar" referrerpolicy="no-referrer" />
        <div class="channel-header-info">
          <h1 class="channel-title">{channel.title}</h1>
          <span class="channel-handle">@{channel.custom_url?.replace('@', '') || channel.id}</span>
          
          <div class="channel-stats">
            <div class="stat-pill">
              <span class="pill-number">{channel.video_count}</span>
              <span class="pill-label">Videos</span>
            </div>
            <div class="stat-pill">
              <span class="pill-number">{(channel.subscriber_count || 0).toLocaleString('es-ES')}</span>
              <span class="pill-label">Suscriptores</span>
            </div>
            <div class="stat-pill">
              <span class="pill-number">{(channel.view_count || 0).toLocaleString('es-ES')}</span>
              <span class="pill-label">Vistas totales</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Description Block -->
      <div class="concept-description-card">
        <h2 class="card-title">Descripción</h2>
        <div class="markdown-body" set:html={channel.bodyHtml}></div>
      </div>

      <!-- Channel Videos Grid -->
      <div class="videos-section">
        <h2 class="section-title">Videos en este canal ({channelVideos.length})</h2>
        <div class="videos-grid">
          {channelVideos.map(video => (
            <a href={`/videos/${video.id}`} class="video-card">
              <div class="video-thumbnail-wrapper">
                <img src={video.thumbnail || '/placeholder.jpg'} alt={video.title} class="video-thumbnail" loading="lazy" referrerpolicy="no-referrer" />
                <span class="video-duration">{video.duration}</span>
              </div>
              <div class="video-card-content">
                <h3 class="video-title" title={video.title}>{video.title}</h3>
                <div class="video-metadata">
                  <span>{parseInt(video.view_count || '0').toLocaleString('es-ES')} vistas</span>
                  <span class="dot">•</span>
                  <span>{new Date(video.published_at).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- OKF Sidebar Column -->
    <aside class="sidebar-column">
      <div class="okf-metadata-card">
        <div class="okf-card-header">
          <span class="okf-icon">ℹ</span>
          <h3>Concepto OKF</h3>
        </div>
        
        <div class="metadata-list">
          <div class="metadata-item">
            <span class="meta-label">Concept ID</span>
            <span class="meta-value monospace" title={`channels/${channel.id}`}>{channel.id.substring(0, 15)}...</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Type</span>
            <span class="meta-value okf-type">{channel.type}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Status</span>
            <span class="meta-value status-active">{channel.status}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Verified</span>
            <span class="meta-value verified-badge">{channel.verified}</span>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Resource</span>
            <a href={channel.resource} target="_blank" rel="noopener noreferrer" class="meta-value link-value">
              Ver en YouTube ↗
            </a>
          </div>
          <div class="metadata-item">
            <span class="meta-label">Generated</span>
            <span class="meta-value monospace">{new Date(channel.generated?.at).toLocaleDateString('es-ES')}</span>
          </div>
        </div>

        <div class="provenance-section">
          <h4>Procedencia (Sources)</h4>
          {channel.sources?.map((source: any) => (
            <div class="source-item">
              <span class="source-title">{source.title}</span>
              <a href={source.resource} target="_blank" rel="noopener noreferrer" class="source-link">
                {source.id} ↗
              </a>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .navigation-wrapper {
    margin-bottom: 2rem;
  }

  .back-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-purple);
  }

  /* Grid Layout layout */
  .channel-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Channel card header */
  .channel-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 2rem;
    backdrop-filter: blur(8px);
  }

  .channel-large-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 3px solid rgba(139, 92, 246, 0.4);
    object-fit: cover;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.15);
  }

  .channel-header-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .channel-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .channel-handle {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 1.25rem;
  }

  .channel-stats {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-pill {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 0.5rem 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .pill-number {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pill-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Description and generic cards */
  .concept-description-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: 16px;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-left: 3px solid var(--accent-purple);
    padding-left: 0.75rem;
  }

  .markdown-body {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Video Grid styling */
  .videos-section {
    margin-top: 1rem;
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .video-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .video-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-hover);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .video-thumbnail-wrapper {
    position: relative;
    aspect-ratio: 16/9;
    background-color: #000;
    overflow: hidden;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .video-card:hover .video-thumbnail {
    transform: scale(1.05);
  }

  .video-duration {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .video-card-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .video-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.8em;
  }

  .video-metadata {
    margin-top: auto;
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .video-metadata .dot {
    color: var(--border-color);
  }

  /* Sidebar styling */
  .okf-metadata-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
    position: sticky;
    top: 5.5rem;
  }

  .okf-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .okf-icon {
    font-size: 1.1rem;
    color: var(--accent-purple);
  }

  .okf-card-header h3 {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .metadata-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-value {
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .meta-value.monospace {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .okf-type {
    background-color: var(--accent-blue-glow);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--accent-blue);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    display: inline-block;
    width: fit-content;
    font-weight: 600;
    font-size: 0.75rem;
  }

  .status-active {
    color: var(--accent-green);
    font-weight: 600;
    text-transform: capitalize;
  }

  .verified-badge {
    background-color: var(--accent-green-glow);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: var(--accent-green);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    display: inline-block;
    width: fit-content;
    font-weight: 600;
    font-size: 0.75rem;
  }

  .link-value {
    color: var(--accent-purple);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .link-value:hover {
    color: var(--text-primary);
  }

  /* Provenance Section */
  .provenance-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .provenance-section h4 {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .source-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .source-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .source-link {
    font-size: 0.75rem;
    color: var(--accent-blue);
    text-decoration: none;
    font-family: var(--font-mono);
  }

  .source-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .channel-layout {
      grid-template-columns: 1fr;
    }
    .sidebar-column {
      position: static;
    }
    .okf-metadata-card {
      position: static;
    }
  }

  @media (max-width: 500px) {
    .channel-header-card {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }
    .channel-stats {
      justify-content: center;
    }
  }
</style>
